<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Garment photos (내 옷장) never leave the device; settings/history may be backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="closet/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="closet/" />
    </device-transfer>
</data-extraction-rules>
