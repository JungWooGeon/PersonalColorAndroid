<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background">#FAF8F6</color>

    <style name="Theme.PersonalColor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.PersonalColor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PersonalColor</item>
    </style>
</resources>
