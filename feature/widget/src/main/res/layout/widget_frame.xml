<?xml version="1.0" encoding="utf-8"?>
<!-- One landing frame: up to 7 stickers in z order + the shine overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/p0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/p1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/p2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/p3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/p4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/p5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/p6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
    <ImageView
        android:id="@+id/shine"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix" />
</FrameLayout>
